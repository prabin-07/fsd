<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Add a product</title>
  <style>
    * { box-sizing: border-box; }

    body {
      min-height: 100vh;
      margin: 0;
      padding: 24px;
      display: grid;
      place-items: center;
      background: #f3f5f9;
      color: #202938;
      font-family: Arial, sans-serif;
    }

    .form-card {
      width: min(100%, 420px);
      padding: 32px;
      border: 1px solid #e2e6ee;
      border-radius: 12px;
      background: #fff;
      box-shadow: 0 12px 35px rgba(25, 39, 65, .08);
    }

    h1 { margin: 0 0 8px; font-size: 1.6rem; }
    .intro { margin: 0 0 24px; color: #687386; line-height: 1.5; }
    .field { margin-bottom: 18px; }

    label {
      display: block;
      margin-bottom: 7px;
      font-size: .9rem;
      font-weight: 600;
    }

    input {
      width: 100%;
      padding: 11px 12px;
      border: 1px solid #cfd6e2;
      border-radius: 7px;
      color: inherit;
      font: inherit;
    }

    input:focus {
      outline: 3px solid rgba(85, 102, 220, .16);
      border-color: #5666dc;
    }

    button {
      width: 100%;
      padding: 12px;
      border: 0;
      border-radius: 7px;
      background: #5666dc;
      color: #fff;
      cursor: pointer;
      font: inherit;
      font-weight: 600;
    }

    button:hover { background: #4655c5; }
    .notice { margin: 0 0 18px; padding: 11px 12px; border-radius: 7px; font-size: .9rem; }
    .notice.success { background: #eaf7ee; color: #25613a; }
    .notice.error { background: #fff0ef; color: #9c3029; }

    @media (max-width: 480px) {
      body { padding: 16px; }
      .form-card { padding: 24px; }
    }
  </style>
</head>
<body>
  <main class="form-card">
    <h1>Add a product</h1>
    <p class="intro">Enter a product name and price.</p>

    {{#if submitted}}
      <p class="notice success" role="status">Product submitted successfully.</p>
    {{/if}}
    {{#if error}}
      <p class="notice error" role="alert">{{error}}</p>
    {{/if}}

    <form action="/submit" method="POST">
      <div class="field">
        <label for="product">Product name</label>
        <input id="product" name="product" type="text" placeholder="e.g. Notebook" required>
      </div>

      <div class="field">
        <label for="price" name="prod_name">Price</label>
        <input id="price" name="prod_price" placeholder="0.00" required>
      </div>

      <button type="submit">Submit product</button>
    </form>
  </main>
</body>
</html>