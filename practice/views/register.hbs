<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/register.css">
    <title>Create an account | Forma</title>
</head>
<body class="account-page register-page">
    <header class="site-header">
        <a class="brand" href="/product/display"><span class="brand-mark">F</span> forma<span class="brand-period">.</span></a>
        <a class="header-link" href="/product/display">Explore the collection <span aria-hidden="true">↗</span></a>
    </header>

    <main class="account-main">
        <section class="account-intro">
            <p class="eyebrow">THE FORMA MARKETPLACE</p>
            <h1>Find your<br>next <span>favorite.</span></h1>
            <p class="intro-copy">Make yourself at home. Create an account to join a collection of useful, lovely finds.</p>
        </section>

        <section class="account-card" aria-labelledby="account-title">
            <div class="card-heading">
                <p class="eyebrow">GET STARTED</p>
                <h2 id="account-title">Create an account</h2>
                <p>A few details are all you need to get started.</p>
            </div>
            <form action="/user/register" method="post">
                <label for="username">Username</label>
                <input id="username" type="text" name="username" placeholder="Choose a username" autocomplete="username" required>

                <label for="user-email">Email</label>
                <input id="user-email" type="email" name="user_email" placeholder="Enter your email" autocomplete="email" required>

                <label for="user-password">Password</label>
                <input id="user-password" type="password" name="user_pass" placeholder="Create a password" autocomplete="new-password" required>

                <button type="submit">Create account <span aria-hidden="true">→</span></button>
            </form>
            <p class="account-switch">Already have an account? <a href="/user/login">Log in</a></p>
        </section>
    </main>

    <footer class="site-footer"><span>FORMA / A place for good finds</span><span>Made for the things you love.</span></footer>
</body>
</html>
