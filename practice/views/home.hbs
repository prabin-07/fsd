<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css">

    <title>Product</title>
</head>
<body>
    <h1>Add Product</h1>
    <form action="/product/add" method="post">
    <label for="pName">Product name</label>
    <input id="pName" type="text" name="pName" placeholder="Enter product name">
    <label for="pPrice">Price</label>
    <input id="pPrice" type="text" name="pPrice" placeholder="Enter price">
    <label for="pCat">Category</label>
    <input id="pCat" type="text" name="pCat" placeholder="Enter category">
    <button type="submit" name="submit">Submit</button>
    </form>
</body>
</html>
