<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Data</title>
</head>
<body>
    <p>Student details</p>
    <form action="/login" method="post">
    Name<input type="text" name="sName" placeholder="Enter student name">
    Batch <input type="text" name="sBatch" placeholder="Enter student's batch">
    Age <input type="text" name="sAge" placeholder="Enter student age">
    Phone Number <input type="text" name="sPhone" placeholder="Enter student phone number">
    <button type="submit" name="enter">Upload</button>
    </form>
</body>
</html>